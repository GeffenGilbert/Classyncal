# Copy to .env on the server and fill in. .env is gitignored and must stay that
# way - it holds every secret the stack has.
#
#   cp .env.example .env && chmod 600 .env

# --- Database ---------------------------------------------------------------
# The host is `postgres`, the Compose service name, not localhost: inside the
# network each service resolves by name. Keep this in sync with POSTGRES_* below.
POSTGRES_USER=syllabus
POSTGRES_PASSWORD=
POSTGRES_DB=syllabus
DATABASE_URL=postgresql+psycopg://syllabus:CHANGE_ME@postgres:5432/syllabus

# --- Redis ------------------------------------------------------------------
REDIS_URL=redis://redis:6379

# --- Reverse proxy ----------------------------------------------------------
# All three are site addresses read straight into the Caddyfile, and Caddy has
# no default for an empty one, so leaving any unset crash-loops the container.
# APP_ADDRESS is the canonical origin serving both the SPA and the API.
# REDIRECT_ADDRESSES are hostnames that 301 to it, separated by "comma space"
# and quoted so the space does not break a shell that sources this file.
# SITE_ADDRESS is the API-only hostname: ":80" = plain HTTP on the bare IP, no
# certificate attempted. Change it to "api.yourdomain.com" once DNS points at
# this box and Caddy handles TLS itself.
APP_ADDRESS=yourdomain.com
REDIRECT_ADDRESSES="www.yourdomain.com, app.yourdomain.com"
SITE_ADDRESS=:80

# --- OpenAI -----------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-nano
# Defaults to 600000 in config.py (~150k tokens). A real syllabus is 20-60k
# characters, so lower this before the endpoint is public - otherwise one large
# upload is an expensive call any stranger can trigger.
MAX_DOCUMENT_CHARS=100000

# --- Google OAuth -----------------------------------------------------------
# Two env vars rather than a mounted credentials.json: the web flow only needs
# these, and it removes a secret *file* from the deploy entirely.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Token encryption -------------------------------------------------------
# Encrypts Google refresh/access tokens at rest in Postgres. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#
# Store a copy somewhere separate from the database backups (a password
# manager). A dump is unreadable without this key - lose it and every user has
# to re-authorize with Google.
TOKEN_ENCRYPTION_KEY=

# --- Development only -------------------------------------------------------
# Lets the OAuth flow run over http:// for localhost testing. Must be unset or
# 0 in production, where the flow runs behind real HTTPS.
OAUTHLIB_INSECURE_TRANSPORT=0

# --- Environment ------------------------------------------------------------
# "development" is the ONLY value that enables OAUTHLIB_INSECURE_TRANSPORT.
# Must be "production" on the VPS.
ENVIRONMENT=production
BACKEND_BASE_URL=https://api.yourdomain.com
FRONTEND_BASE_URL=https://app.yourdomain.com
# Must match the deployed frontend origin or the browser blocks every API call.
CORS_ORIGIN_REGEX=https://app\.yourdomain\.com

# --- Rate limiting ----------------------------------------------------------
# /upload-syllabus needs no login and costs money per call. Defaults shown.
# Per-IP is deliberately much higher than per-session: universities NAT many
# students behind one address, so a low value would lock out a whole campus.
RATE_LIMIT_PER_SESSION_HOURLY=10
RATE_LIMIT_PER_IP_HOURLY=60
# The circuit breaker on a day's OpenAI spend, regardless of who is calling.
RATE_LIMIT_GLOBAL_DAILY=500
